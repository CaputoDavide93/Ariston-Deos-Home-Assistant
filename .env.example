# Read by scripts/probe.py only; the integration itself reads no environment
# (Home Assistant keeps the login in its config entry). Copy to .env, fill in,
# and export the two variables, or leave them unset and type them at the prompt.
# Your own Ariston Clima app login. Never committed (.env is git-ignored).
ARISTON_EMAIL=you@example.com
ARISTON_PASSWORD=CHANGE_ME
